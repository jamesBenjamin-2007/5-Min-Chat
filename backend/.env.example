# Comma-separated list of frontend origins allowed to connect.
# Use your real Vercel + custom domain URLs in production - do NOT leave
# this as "*" once you're live, or any website can open sockets to your
# backend.
FRONTEND_URL=https://5minchat.online,https://www.5minchat.online,https://5minchat.vercel.app

# Render sets PORT automatically - you don't need to set this yourself
# on Render, it's here for local dev.
PORT=4000

# Optional: only needed if you wire up an external moderation provider
# in moderation.js (OpenAI Moderation API, Perspective API, etc).
MODERATION_PROVIDER_KEY=

# Feed feature (posts + likes) - create a free project at supabase.com,
# then Project Settings -> API to find these two values. Use the
# "service_role" key (not the "anon" key) since this runs server-side.
# Without these set, /api/posts endpoints return 503 but the chat feature
# keeps working normally.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
